<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rviz_marker_tools_ros2</name>
  <version>0.0.1</version>
  <description>RViz marker tools for ROS2</description>
  <maintainer email="ak.lui@qut.edu.au">Andrew Lui</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_copyright</buildtool_depend>
  <buildtool_depend>ament_flake8</buildtool_depend>
  <buildtool_depend>ament_pep257</buildtool_depend>
  <buildtool_depend>python3-pytest</buildtool_depend>
  <buildtool_depend>python3-setuptools</buildtool_depend>

    <!-- ROS 2 runtime dependencies go here -->
  <depend>rclpy</depend>
  <depend>visualization_msgs</depend>
  <depend>tf_transformations</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>

