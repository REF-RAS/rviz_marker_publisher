<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rviz_marker_publisher</name>
  <version>0.0.1</version>
  <description>RViz marker tools for ROS2</description>
  <maintainer email="ak.lui@qut.edu.au">Andrew Lui</maintainer>
  <license>BSD-3-Clause Non-AI</license>

  <buildtool_depend>python3-pytest</buildtool_depend>
  <buildtool_depend>python3-setuptools</buildtool_depend>
  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>geometry_msgs</depend>
  <depend>tf_transformations</depend>

  <test_depend>python3-pytest</test_depend>
  
  <!-- instruct colcon build to use setup.py for the installation -->
  <export>
    <build_type>ament_python</build_type>
  </export>

</package>